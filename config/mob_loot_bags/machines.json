      "minecraft:netherite_chestplate": 40,
      "minecraft:netherite_leggings": 36,
      "minecraft:netherite_boots": 24,
      "simplyswords:whisperwind": 32,
      "simplyswords:watcher_claymore": 32,
      "simplyswords:twisted_blade": 32,
      "simplyswords:thunderbrand": 32,
      "simplyswords:the_devourer": 32,
      "simplyswords:tempest": 32,
      "simplyswords:sunfire": 32,
      "simplyswords:stormbringer": 32,
