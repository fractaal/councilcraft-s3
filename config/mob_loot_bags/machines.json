// Mob Loot Bags 2.0: the Bag Opener and the Loot Recycler.
// Edit and run /lootbags reload, or restart. Missing keys are restored with their defaults.
{
  // ticks_per_bag: how long the Bag Opener takes per bag (20 ticks = 1 second).
  "opener": {
    "ticks_per_bag": 20
  },

  // The Loot Recycler grinds mob-farm junk into salvage points and turns points_per_bag points into
  // one output_bag. Loot bags fed to it become stored experience instead (bag_xp).
  // junk: salvage points per item. Keys are item ids or #item tags. Anything not listed is refused.
  // Enchantments don't change an item's points: the mod only reads the item id.
  "recycler": {
    "ticks_per_item": 5,
    // 64 is the mod's default. The junk values below were multiplied instead (TechKeeper, 2026-11-17).
    "points_per_bag": 64,
    "output_bag": "common",
    "bag_xp": {
      "common": 10,
      "uncommon": 20,
      "rare": 40,
      "epic": 80,
      "legendary": 200,
      "mythic": 500,
      "cursed": 60,
      "hourglass": 40,
      "locked": 40,
      "summoning": 40,
      "ripe_hourglass": 200
    },
    "junk": {
      "#mob_loot_bags:recycler_junk": 5,
      "minecraft:spider_eye": 10,
      "minecraft:gunpowder": 10,
      "minecraft:slime_ball": 10,
      "minecraft:phantom_membrane": 15,
      "minecraft:ender_pearl": 20,
      "minecraft:blaze_rod": 20,
      "minecraft:ghast_tear": 30,
      "minecraft:bow": 30,
      "minecraft:crossbow": 30,
      "minecraft:golden_sword": 30,
      "minecraft:iron_sword": 40,
      "minecraft:chainmail_helmet": 40,
      "minecraft:chainmail_chestplate": 60,
      "minecraft:chainmail_leggings": 50,
      "minecraft:chainmail_boots": 30,
      "minecraft:golden_helmet": 40,
      "minecraft:golden_chestplate": 60,
      "minecraft:golden_leggings": 50,
      "minecraft:golden_boots": 30,
      // On 2026-11-17 TechKeeper set weapons, tools and armor to 10x their earlier points and everything else
      // to 5x, so a diamond chestplate (once 16) is 160 points and a bone (once 1) is 5.
      // Gear that loot bags give (Aero Loot Bags), so unwanted drops can be recycled too.
      "minecraft:leather_helmet": 10,
      "minecraft:leather_chestplate": 20,
      "minecraft:leather_leggings": 20,
      "minecraft:leather_boots": 10,
      "minecraft:stone_sword": 10,
      "minecraft:stone_pickaxe": 10,
      "minecraft:stone_axe": 10,
      "minecraft:fishing_rod": 10,
      "minecraft:shears": 20,
      "minecraft:shield": 20,
      "minecraft:iron_pickaxe": 40,
      "minecraft:iron_axe": 40,
      "minecraft:iron_helmet": 50,
      "minecraft:iron_chestplate": 80,
      "minecraft:iron_leggings": 70,
      "minecraft:iron_boots": 40,
      "minecraft:diamond_sword": 80,
      "minecraft:diamond_pickaxe": 80,
      "minecraft:diamond_axe": 80,
      "minecraft:diamond_shovel": 30,
      "minecraft:diamond_helmet": 100,
      "minecraft:diamond_chestplate": 160,
      "minecraft:diamond_leggings": 140,
      "minecraft:diamond_boots": 80,
      // Other gear mobs and bags drop, and Simple Hats hats (asked for by TechKeeper, 2026-11-16).
      "minecraft:iron_shovel": 20,
      "minecraft:iron_hoe": 20,
      "minecraft:golden_axe": 30,
      "minecraft:golden_pickaxe": 30,
      "minecraft:golden_shovel": 10,
      "minecraft:golden_hoe": 10,
      "minecraft:diamond_hoe": 30,
      "minecraft:trident": 80,
      "minecraft:mace": 160,
      "minecraft:netherite_sword": 120,
      "minecraft:netherite_pickaxe": 120,
      "minecraft:netherite_axe": 120,
      "minecraft:netherite_shovel": 70,
      "minecraft:netherite_hoe": 70,
      "minecraft:netherite_helmet": 140,
      "minecraft:netherite_chestplate": 200,
      "minecraft:netherite_leggings": 180,
      "minecraft:netherite_boots": 120,
      "simplyswords:whisperwind": 160,
      "simplyswords:watcher_claymore": 160,
      "simplyswords:twisted_blade": 160,
      "simplyswords:thunderbrand": 160,
      "simplyswords:the_devourer": 160,
      "simplyswords:tempest": 160,
      "simplyswords:sunfire": 160,
      "simplyswords:stormbringer": 160,
      "simplyswords:stars_edge": 160,
      "simplyswords:soulstealer": 160,
      "simplyswords:soulrender": 160,
      "simplyswords:soulpyre": 160,
      "simplyswords:soulkeeper": 160,
      "simplyswords:shadowsting": 160,
      "simplyswords:molten_edge": 160,
      "simplyswords:livyatan": 160,
      "simplyswords:icewhisper": 160,
      "simplyswords:hearthflame": 160,
      "simplyswords:harbinger": 160,
      "simplyswords:frostfall": 160,
      "simplyswords:emberblade": 160,
      "simplyswords:caelestis": 160,
      "simplyswords:brimstone_claymore": 160,
      "simplyswords:arcanethyst": 160,
      "#mob_loot_bags:recycler_hats": 10,
      "simplehats:hatbag_common": 10,
      "simplehats:hatbag_uncommon": 15,
      "simplehats:hatbag_rare": 25,
      "simplehats:hatbag_epic": 40,
      "simplehats:hatbag_easter": 15,
      "simplehats:hatbag_festive": 15,
      "simplehats:hatbag_halloween": 15,
      "simplehats:hatbag_summer": 15,
      "minecraft:amethyst_shard": 5,
      // 4 small essence craft into 1 great and back, so great is worth 4 small.
      "knightlib:small_essence": 5,
      "knightlib:great_essence": 20,
      // Every Apotheosis gem is one item id, so all rarities count the same here.
      "apotheosis:gem": 20,
      // Ash and Mystical Agriculture essences (asked for by TechKeeper, 2026-11-16). The tag holds inferium
      // and every resource essence; each tier essence crafts from 4 of the one below and back, so it is worth 4.
      "supplementaries:ash": 5,
      "#mysticalagriculture:essences": 5,
      "mysticalagriculture:fertilized_essence": 5,
      "mysticalagriculture:prudentium_essence": 20,
      "mysticalagriculture:tertium_essence": 80,
      "mysticalagriculture:imperium_essence": 320,
      "mysticalagriculture:supremium_essence": 1280,
      "mysticalagradditions:insanium_essence": 5120,
      // Reliquary's zombie heart, a rarer zombie drop, priced like the other uncommon mob drops (TechKeeper, 2026-11-16).
      "reliquary:zombie_heart": 10,
      // Wither skeleton drops and ectoplasm (TechKeeper, 2026-11-17): the rarer drops at 2 like the zombie heart,
      // Eternal Nether's withered bone at 1 like a plain bone.
      "bhc:wither_bone": 10,
      "reliquary:withered_rib": 10,
      "eternalnether:withered_bone": 5,
      "irregular_implements:ectoplasm": 10,
      // Name tags, a loot item with no crafting recipe, priced like a bow (TechKeeper, 2026-11-17).
      "minecraft:name_tag": 15,
      // Royal Variations knight armor, chainmail upgraded with royal armor fragments, at twice chainmail (TechKeeper, 2026-11-17).
      "royalvariations:royal_knight_helmet": 80,
      "royalvariations:royal_knight_cuirass": 120,
      "royalvariations:royal_knight_leggings": 100,
      "royalvariations:royal_knight_boots": 60,
      // Cataclysm's dying ember (Ignited Berserker drop) at 10 like the zombie heart, and Iron's
      // Spellbooks' Blaze Instruction Manual, a loot-only spell book, priced like knight armor (TechKeeper, 2026-11-17).
      "cataclysm:dying_ember": 10,
      "irons_spellbooks:blaze_spell_book": 80,
      // Immersive Melodies instruments (TechKeeper, 2026-11-17). They craft from cheap things, so each is worth
      // what its recyclable ingredients are worth (bone, string and leather at 5, ender pearl at 20) and crafting
      // one gains nothing. Triangle, trumpet, handpan and didgeridoo are left out: they are made only from copper,
      // iron, lapis or wood, none of which the recycler takes, so listing them would turn those into loot bags.
      "immersive_melodies:flute": 5,
      "immersive_melodies:lute": 5,
      "immersive_melodies:vielle": 5,
      "immersive_melodies:piano": 15,
      "immersive_melodies:ender_bass": 20,
      "immersive_melodies:tiny_drum": 25,
      "immersive_melodies:bagpipe": 40
    }
  }
}
