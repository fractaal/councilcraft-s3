// Mob Loot Bags 2.0: the Bag Opener and the Loot Recycler.
// Edit and run /lootbags reload, or restart. Missing keys are restored with their defaults.
{
  // ticks_per_bag: how long the Bag Opener takes per bag (20 ticks = 1 second).
  "opener": {
    "ticks_per_bag": 20
  },

  // The Loot Recycler grinds mob-farm junk into salvage points and turns points_per_bag points into
  // one output_bag. Loot bags fed to it become stored experience instead (bag_xp).
  // junk: salvage points per item. Keys are item ids or #item tags. Anything not listed is refused.
  // Enchantments don't change an item's points: the mod only reads the item id.
  "recycler": {
    "ticks_per_item": 5,
    // Was 64; set to 21 on 2026-11-17 so every item is worth about three times as much (TechKeeper asked for 3x).
    "points_per_bag": 21,
    "output_bag": "common",
    "bag_xp": {
      "common": 10,
      "uncommon": 20,
      "rare": 40,
      "epic": 80,
      "legendary": 200,
      "mythic": 500,
      "cursed": 60,
      "hourglass": 40,
      "locked": 40,
      "summoning": 40,
      "ripe_hourglass": 200
    },
    "junk": {
      "#mob_loot_bags:recycler_junk": 1,
      "minecraft:spider_eye": 2,
      "minecraft:gunpowder": 2,
      "minecraft:slime_ball": 2,
      "minecraft:phantom_membrane": 3,
      "minecraft:ender_pearl": 4,
      "minecraft:blaze_rod": 4,
      "minecraft:ghast_tear": 6,
      "minecraft:bow": 6,
      "minecraft:crossbow": 6,
      "minecraft:golden_sword": 6,
      "minecraft:iron_sword": 8,
      "minecraft:chainmail_helmet": 8,
      "minecraft:chainmail_chestplate": 12,
      "minecraft:chainmail_leggings": 10,
      "minecraft:chainmail_boots": 6,
      "minecraft:golden_helmet": 8,
      "minecraft:golden_chestplate": 12,
      "minecraft:golden_leggings": 10,
      "minecraft:golden_boots": 6,
      // Weapons, tools and armor are worth twice what they were before 2026-11-17, so with 21 points per bag
      // gear pays about 6x the original rate and mob drops about 3x (TechKeeper, 2026-11-17).
      // Gear that loot bags give (Aero Loot Bags), so unwanted drops can be recycled too.
      "minecraft:leather_helmet": 2,
      "minecraft:leather_chestplate": 4,
      "minecraft:leather_leggings": 4,
      "minecraft:leather_boots": 2,
      "minecraft:stone_sword": 2,
      "minecraft:stone_pickaxe": 2,
      "minecraft:stone_axe": 2,
      "minecraft:fishing_rod": 2,
      "minecraft:shears": 4,
      "minecraft:shield": 4,
      "minecraft:iron_pickaxe": 8,
      "minecraft:iron_axe": 8,
      "minecraft:iron_helmet": 10,
      "minecraft:iron_chestplate": 16,
      "minecraft:iron_leggings": 14,
      "minecraft:iron_boots": 8,
      "minecraft:diamond_sword": 16,
      "minecraft:diamond_pickaxe": 16,
      "minecraft:diamond_axe": 16,
      "minecraft:diamond_shovel": 6,
      "minecraft:diamond_helmet": 20,
      "minecraft:diamond_chestplate": 32,
      "minecraft:diamond_leggings": 28,
      "minecraft:diamond_boots": 16,
      // Other gear mobs and bags drop, and Simple Hats hats (asked for by TechKeeper, 2026-11-16).
      "minecraft:iron_shovel": 4,
      "minecraft:iron_hoe": 4,
      "minecraft:golden_axe": 6,
      "minecraft:golden_pickaxe": 6,
      "minecraft:golden_shovel": 2,
      "minecraft:golden_hoe": 2,
      "minecraft:diamond_hoe": 6,
      "minecraft:trident": 16,
      "minecraft:mace": 32,
