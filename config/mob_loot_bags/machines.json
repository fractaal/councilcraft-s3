      "minecraft:chainmail_leggings": 5,
      "minecraft:chainmail_boots": 3,
      "minecraft:golden_helmet": 4,
      "minecraft:golden_chestplate": 6,
      "minecraft:golden_leggings": 5,
      "minecraft:golden_boots": 3,
