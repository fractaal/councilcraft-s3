	reward_table.41AB264E28626CDB.title: "&bRelic Bag"
	reward_table.44675FF0C802B588.title: "Utility Spell Scrolls"
	reward_table.4C8FB9DCD296AB30.title: "Minecarts"
	reward_table.4E819C4008591562.title: "Copper"
	reward_table.52BCDDCCA3B53D25.title: "Arrows"
	reward_table.543CC42C2F150280.title: "Create"
	reward_table.54A59E28AEF54565.title: "Logs"
	reward_table.5712B58E61E57DD6.title: "Ender IO materials"
	reward_table.578E1484350EB4BD.title: "Beds"
	reward_table.57F9581ADF8124DA.title: "Ender IO Grinding balls"
	reward_table.5980398643E65CBF.title: "&bTechnology&r Bundle"
	reward_table.5B42C6EDEE6F753F.title: "Artifacts (necklace)"
	reward_table.5BCC8C36533C57D3.title: "Artifacts (head)"
	reward_table.5F726AD2B912C6C3.title: "&6Legendary Crate&r"
	reward_table.61D338F0B6CBFAD3.title: "&bRandom Seed Bag"
	reward_table.63587E4FE7F6C833.title: "Diamond"
	reward_table.63F56955C7721E25.title: "Redstone materials"
	reward_table.69C7527692645044.title: "Uraninite and coal"
