	task.7EA00D7548DFAE17.title: "&eKill&f: &cIgnited Revenant"
	quest.67E9EE3BEDB801B5.title: "Challenge the Leviathan"
	quest.74647E2214729AD6.title: "Defeat the Netherite Monstrosity"
	quest.5CE773814750FE5C.title: "The Harbinger Expedition"
	quest.0F9701557D63D898.title: "Defeat the Ancient Remnant"
	quest.67E9EE3BEDB801B5.quest_desc: [
		"This milestone requires the listed Coralssus and Deepling Priest kills, an Abyssal Sacrifice, and the Leviathan kill. Read every task before setting out."
		"Use Cataclysm's current information and JEI to investigate the summoning item. Bring equipment appropriate to an underwater encounter and secure a retreat."
	]
	quest.74647E2214729AD6.quest_desc: [
		"Defeat Cataclysm's Netherite Monstrosity. This kill is required for the quest; it is no longer an optional-only objective."
		"Prepare a safe approach through the Nether, a supply of food and a reliable escape route."
	]
	quest.659F9057A150189E.title: "The Ruined Citadel"
	quest.659F9057A150189E.quest_desc: [
		"Locate Cataclysm's Ruined Citadel and defeat its Ender Guardian. The Ender Golem objective is an optional extra."
		"Read the structure and kill tasks separately: entering the structure alone does not complete the boss encounter. Prepare a safe End return route."
	]
	quest.5CE773814750FE5C.quest_desc: [
		"Defeat the Watcher, the Prowler and the Harbinger. All three listed kills are required."
		"Scout Cataclysm locations in this world and prepare equipment before attempting the boss. Completing only a smaller encounter does not finish this milestone."
	]
	quest.0F9701557D63D898.quest_desc: [
		"Defeat Cataclysm's Ancient Remnant. Consult the current mod's progression and JEI for encounter-related items."
		"Treat this as a late combat milestone. Clear a safe approach, carry supplies, and plan recovery before engaging."
	]
}
