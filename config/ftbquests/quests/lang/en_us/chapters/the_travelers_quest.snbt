{
	quest.000F1E507ACDFAAE.quest_desc: [
		"Enter Cataclysm's Acropolis and defeat Scylla. Clawdian is an optional additional encounter."
		"This uses the registered Cataclysm structure, not a donor-only replacement. Follow the installed mod's encounter instructions and inspect any activation items in JEI."
	]
	quest.000F1E507ACDFAAE.title: "The Acropolis Expedition"
	quest.12468F8BF7B80737.quest_desc: [
		"Obtain an Explorer's Compass and use it to search for structures registered in this pack. Large searches can take time; choose one target at a time."
		"Recipes and trades from FTB Aero are not assumed here. Use JEI for this pack's recipe and prepare a return route before travelling."
	]
	quest.12468F8BF7B80737.title: "Adventuring Beyond"
	quest.12498DE8D427D40E.quest_desc: [
		"Enter a YUNG's Better Nether Fortresses structure. This task specifically detects betterfortresses:fortress, rather than any Nether building."
		"Bring fire protection and mark a safe path back. Newly generated chunks may be needed to find structures added after world creation."
	]
	quest.12498DE8D427D40E.title: "Find a Nether Fortress"
	quest.3A084B83B8CFAACD.quest_desc: [
		"Defeat the listed Ignited Berserker, Ignited Revenant and Ignis. This quest tracks those encounters; it does not depend on FTB Aero's custom coliseum."
		"Search for Cataclysm structures present in this world and consult the installed mod's summoning instructions. Prepare for fire and lava before committing."
	]
	quest.3A084B83B8CFAACD.title: "The Ignis Expedition"
	quest.3CCE39C0957034B3.quest_desc: [
		"Defeat two Cataclysm Koboletons. This is a required combat objective; the quest does not promise an FTB-specific desert island."
		"Use exploration and the structures actually present in this pack to locate suitable encounters."
	]
	quest.3CCE39C0957034B3.title: "Hunt Two Koboletons"
	quest.4F8C7DC594972DE4.quest_desc: [
		"Defeat Cataclysm's Aptrgangr and Maledictus. Both listed kills are required."
		"Do not rely on FTB Aero's Ice Castle description: locate Cataclysm structures available in this world and follow the installed mod's progression."
	]
	quest.4F8C7DC594972DE4.title: "Aptrgangr and Maledictus"
	quest.7D22824ADC29DA26.quest_desc: [
		"Defeat one Cataclysm Amethyst Crab. This objective tracks the creature, not an FTB Aero custom altar or island."
		"Scout terrain around the encounter and leave space to retreat before attacking."
	]
	quest.7D22824ADC29DA26.title: "Defeat an Amethyst Crab"
	task.01A8B6D685C1FB27.title: "&eKill&f: &dAmethyst Crab"
