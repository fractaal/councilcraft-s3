	quest.725E648984E4FFBF.quest_desc: [
		"The &6Black Hole&f can produce up to 50,000 RF each time it consumes a block if a &aTachyon Absorber&f is placed on the opposite side of where that block was consumed relative to the &6Black Hole&f."
		""
		"&c&lWARNING!&r Do &lNOT&r build this setup inside a &bCompact Machine&r. The room does not tick reliably while you are outside it, so your block placer falls behind and the &6Black Hole&r will consume your setup."
		""
		"[\"Check the \", {\"text\": \"Black Hole GuideMe\", \"underlined\":true, \"color\": \"aqua\", \"clickEvent\": {\"action\": \"run_command\", \"value\": \"/guideme open @s oritech:guide oritech:black_hole_generator.md\"}, \"hoverEvent\": {\"action\": \"show_text\", \"contents\": \"Open GuideMe Page\"}},\" for an example setup.\"]"
	]
	quest.725E648984E4FFBF.title: "&dBlack Hole Power&r"
	quest.72B5E5B3788E6E6C.quest_desc: ["Consumes slime balls and milk.", "", "&o&7Used for the Rainbow Generator"]
	quest.748DAA46EC10AA3F.quest_desc: ["The &aCoral Generator&f consumes liquid coral to produce 5,000 RF/t."]
	quest.754048401D3A6A7B.quest_desc: [
		"This chapter covers most of the different ways to generate power."
		""
		"&eNote&f: FE and RF are the same thing. Some mods still use RF (Redstone Flux) and others use FE (Forge Energy). Both are effectively the same."
		""
		"EU, however, is used by &eModern Industrialization&f and converts at a ratio of 1:10 to RF/t"
	]
	quest.754048401D3A6A7B.title: "&fPower \\&\\ You"
