		quest.6D03D3B4D83C1840.quest_desc: {
			old: [
				"The &eMechanical Crafter&r is used for automated crafting. Use a &bWrench&r on its front to set the output direction. Multiple crafters can be placed together to form a crafting grid."
				""
				"{@pagebreak}"
				""
				"When powered and all ingredient slots for a valid recipe are filled, the crafters will combine the items into the final product."
			]
			new: [
				"The &eMechanical Crafter&r is used for automated crafting. Use a &bWrench&r on its front to set the output direction. Multiple crafters can be placed together to form a crafting grid."
				"{@pagebreak}"
				"When powered and all ingredient slots for a valid recipe are filled, the crafters will combine the items into the final product."
			]
		}
