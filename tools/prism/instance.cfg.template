[General]
ConfigVersion=1.2
InstanceType=OneSix
iconKey=flame
name=CouncilCraft Season 3
notes=Installs and updates itself from @PACK_URL@ every time it launches (packwiz). First launch downloads about 1 GB of mods.
AutomaticJava=true
OverrideMemory=true
MinMemAlloc=6144
MaxMemAlloc=12288
OverrideJavaArgs=true
JvmArgs=-XX:+UseG1GC -XX:+UnlockExperimentalVMOptions -XX:G1NewSizePercent=20 -XX:G1ReservePercent=20 -XX:MaxGCPauseMillis=50 -XX:G1HeapRegionSize=32M -XX:+ParallelRefProcEnabled -XX:SymbolTableSize=4194304 -XX:MetaspaceSize=1g
OverrideCommands=true
PreLaunchCommand="\"$INST_JAVA\" -jar packwiz-installer-bootstrap.jar @PACK_URL@"
LogPrePostOutput=true
ShowConsoleOnError=true
